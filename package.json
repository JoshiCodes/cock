{
	"name": "@joshicodes/cock",
	"version": "0.1.1",
	"description": "Svelte 5 and Tailwind 4 component kit: 63 accessible components, dark mode and theming from three CSS variables.",
	"license": "MIT",
	"author": "JoshiCodes (https://github.com/JoshiCodes)",
	"homepage": "https://cock.joshicodes.de",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshiCodes/cock.git"
	},
	"bugs": {
		"url": "https://github.com/JoshiCodes/cock/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"tailwindcss",
		"tailwind4",
		"components",
		"component-library",
		"ui",
		"design-system",
		"runes",
		"accessible",
		"dark-mode"
	],
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme.css": "./dist/styles/theme.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun run prepack",
		"build:site": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.6",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
